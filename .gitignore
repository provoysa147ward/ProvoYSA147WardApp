# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/blob-report/

# generated by playwright.config.ts from tests/e2e/fixtures/calendarEvents.ts
/tests/e2e/fixtures/calendar-events.json

# Database dumps. The backup taken before the events drop migration lands in
# the repo root by default and contains real submitter names, emails, and phone
# numbers — this repository is public, so a dump must never be committed.
# Better still, write it somewhere outside the working tree entirely.
/*-backup.sql
/*.dump
