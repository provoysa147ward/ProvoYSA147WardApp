# Copy to .env.local and fill in. Every value here is per-environment; nothing
# in this file is a secret, but .env.local is gitignored because it will be.
#
# Local development: run `supabase start`, then `supabase status` prints the
# three Supabase values below for the local stack.

# --- Supabase (required) ---------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Shipped to the browser; every request it
# makes is subject to row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Bypasses row-level security — server-only, and
# never prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
