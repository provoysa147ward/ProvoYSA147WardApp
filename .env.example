# Copy to .env.local and fill in. Every value here is per-environment; nothing
# in this file is a secret, but .env.local is gitignored because it will be.
#
# Local development: run `supabase start`, then `supabase status` prints the
# three Supabase values below for the local stack.

# --- Supabase (required) ---------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Shipped to the browser; every request it
# makes is subject to row-level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Bypasses row-level security — server-only, and
# never prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Google Calendar sync (optional) ---------------------------------------
#
# Sync turns on only when all three are present. Without them the site works
# fully; approved events queue as "not synced" until an admin presses Retry.
# Setup runbook: docs/HANDOFF.md.

GOOGLE_SA_CLIENT_EMAIL=
# The service account private key, newlines escaped as \n.
GOOGLE_SA_PRIVATE_KEY=
# The ward calendar's id, shared with the service account above.
GOOGLE_CALENDAR_ID=

# --- Cron (required in production) -----------------------------------------
#
# Any long random string. Vercel sends it as a bearer token to /api/keepalive,
# which keeps the free Supabase project from pausing after 7 idle days.
CRON_SECRET=
